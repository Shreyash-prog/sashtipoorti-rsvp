{
  "cleanUrls": true,
  "headers": [
    { "source": "/", "headers": [
      { "key": "Cache-Control", "value": "no-store, no-cache, max-age=0, must-revalidate" },
      { "key": "Pragma", "value": "no-cache" },
      { "key": "Expires", "value": "0" } ] },
    { "source": "/index.html", "headers": [
      { "key": "Cache-Control", "value": "no-store, no-cache, max-age=0, must-revalidate" },
      { "key": "Pragma", "value": "no-cache" },
      { "key": "Expires", "value": "0" } ] },
    { "source": "/index", "headers": [
      { "key": "Cache-Control", "value": "no-store, no-cache, max-age=0, must-revalidate" } ] },
    { "source": "/vid/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/img/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/aud/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
  ]
}
